NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://fieldops:change_me@localhost:5432/fieldops_pro
JWT_ACCESS_SECRET=replace-with-32-plus-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-plus-random-characters
# Use a separate secret so Aadhaar fingerprints cannot be correlated with JWTs.
AADHAAR_HASH_SECRET=replace-with-a-third-32-plus-random-secret
FIREBASE_PUSH_ENABLED=false
# Enable one credential mode in production. Never commit real credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"...","clientEmail":"...","privateKey":"-----BEGIN PRIVATE KEY-----\\n..."}
# Or set FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY.
# On Google Cloud, opt in to Application Default Credentials instead:
# FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=true
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
OBJECT_STORAGE_SIGNER_URL=
OBJECT_STORAGE_SIGNER_TOKEN=
TECHNICIAN_REQUIRED_DOCUMENT_TYPES=IDENTITY,ADDRESS
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_MAPS_SERVER_KEY=
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
